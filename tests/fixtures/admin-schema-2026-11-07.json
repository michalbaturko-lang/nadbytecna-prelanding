  "functions": [
    {
      "name": "clear_private_on_insert",
      "definition": "CREATE OR REPLACE FUNCTION public.clear_private_on_insert()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nbegin\n if tg_op = 'INSERT' and current_user = 'anon' then\n new.ai_summary := null;\n new.ai_category := null;\n new.ai_category_confirmed := null;\n new.ai_urgency := null;\n new.ai_help_type := null;\n new.ai_model := null;\n new.ai_at := null;\n new.admin_note := null;\n if tg_table_name = 'help_offers' then\n new.ai_matches := null;\n end if;\n end if;\n return new;\nend;\n$function$\n"
    },
    {
      "name": "help_guard",
      "definition": "CREATE OR REPLACE FUNCTION public.help_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nbegin\n if tg_op = 'INSERT' then\n new.mail_sent_at := null;\n new.status := 'new';\n return new;\n end if;\n if tg_op = 'UPDATE' and current_user in ('anon', 'authenticated') then\n if current_user = 'authenticated' and public.is_admin() then\n new.id := old.id;\n new.created_at := old.created_at;\n new.full_name := old.full_name;\n new.email := old.email;\n new.phone := old.phone;\n new.helper_type := old.helper_type;\n new.help_kinds := old.help_kinds;\n new.message := old.message;\n new.links := old.links;\n new.consent := old.consent;\n new.mail_sent_at := old.mail_sent_at;\n return new;\n end if;\n return old;\n end if;\n return new;\nend;\n$function$\n"
    },
    {
      "name": "is_admin",
      "definition": "CREATE OR REPLACE FUNCTION public.is_admin()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n select exists (select 1 from public.admins where user_id = auth.uid())\n or exists (\n select 1 from public.admin_emails\n where email = lower(coalesce(auth.jwt() ->> 'email', ''))\n );\n $function$\n"
    },
    {
      "name": "save_transcript",
      "definition": "CREATE OR REPLACE FUNCTION public.save_transcript(p_id uuid, p_text text)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\ndeclare\n n int;\nbegin\n if p_id is null or p_text is null or char_length(btrim(p_text)) < 1 or char_length(p_text) > 20000 then\n return false;\n end if;\n update public.stories\n set transcript = btrim(p_text)\n where id = p_id\n and transcript is null\n and audio_path is not null\n and consent is true\n and created_at > now() - interval '30 minutes';\n get diagnostics n = row_count;\n return n = 1;\nend;\n$function$\n"
    },
    {
      "name": "stories_guard",
      "definition": "CREATE OR REPLACE FUNCTION public.stories_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nbegin\n if tg_op = 'INSERT' then\n new.transcript := null;\n new.mail_sent_at := null;\n new.status := 'new';\n return new;\n end if;\n if tg_op = 'UPDATE' and current_user in ('anon', 'authenticated') then\n if current_user = 'authenticated' and public.is_admin() then\n new.id := old.id;\n new.created_at := old.created_at;\n new.full_name := old.full_name;\n new.email := old.email;\n new.anonymous := old.anonymous;\n new.wants_to_help := old.wants_to_help;\n new.input_type := old.input_type;\n new.story_text := old.story_text;\n new.audio_path := old.audio_path;\n new.transcript := old.transcript;\n new.consent := old.consent;\n new.mail_sent_at := old.mail_sent_at;\n return new;\n end if;\n return old;\n end if;\n return new;\nend;\n$function$\n"
    }
  ],
