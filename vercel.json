  ],
  "crons": [
    {
      "path": "/api/shop-reconcile/",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/retention/",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/ai-worker/",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/mail-sync/",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mail-ai-worker/",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mail-archive-worker/",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/notify.js": {
      "includeFiles": "emails/**/*"
    },
    "api/ai-worker.js": {
      "maxDuration": 120
    },
    "api/admin.js": {
      "maxDuration": 60,
      "includeFiles": "assets/pdf/**"
    },
    "api/admin-shop.js": {
      "maxDuration": 45
    },
    "api/shop-reconcile.js": {
      "maxDuration": 60
    },
    "api/shopify-webhooks.js": {
      "maxDuration": 10
    },
    "api/mail-sync.js": {
      "maxDuration": 180
    },
    "api/admin-mail.js": {
      "maxDuration": 180
    },
    "api/mail-connect.js": {
      "maxDuration": 120
    },
    "api/mail-ai-worker.js": {
      "maxDuration": 120
    },
    "api/mail-archive-worker.js": {
      "maxDuration": 300
    }
  }
}
