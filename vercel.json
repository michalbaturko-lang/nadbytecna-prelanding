      "permanent": true
    },
    {
      "source": "/o-nasi-platforme",
      "destination": "/o-nas/",
      "permanent": true
    },
    {
      "source": "/o-nasi-platforme/",
      "destination": "/o-nas/",
      "permanent": true
    },
    {
      "source": "/pribeh",
      "destination": "/verin-pribeh/",
      "permanent": true
    },
    {
      "source": "/pribeh/",
      "destination": "/verin-pribeh/",
      "permanent": true
    },
    {
      "source": "/dekujeme",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dekujeme/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/potvrzeno",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/potvrzeno/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/potvrzeni",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/potvrzeni/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/odhlaseni",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/odhlaseni/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sk",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sk/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sk/zasady-ochrany-osobnych-udajov",
      "destination": "/ochrana-osobnich-udaju/",
      "permanent": true
    },
    {
      "source": "/sk/zasady-ochrany-osobnych-udajov/",
