{
  "name": "nadbytecna-prelanding",
  "version": "1.0.0",
  "scripts": {
    "build": "node build.mjs",
    "build:preview": "node build.mjs --all",
    "test": "node --test tests/*.test.mjs",
    "test:admin:browser": "PHASE1=1 node build.mjs && node tools/admin-browser.mjs",
    "test:admin:public": "node tools/admin-public-regression.mjs",
    "test:admin:lighthouse": "PHASE1=1 node build.mjs && node tools/admin-lighthouse.mjs",
    "preview:admin": "PHASE1=1 node build.mjs && node tools/admin-preview.mjs",
    "test:admin:mail": "PHASE1=1 node build.mjs && node tools/admin-mail-browser.mjs && MAIL_UI_EXTENDED=true node tools/admin-mail-integration.mjs",
    "check:m365": "node tools/m365-check.mjs",
    "test:mail:connect": "node --test tests/m365-oauth-client.test.mjs tests/m365-oauth-db.test.mjs tests/mail-connect-api.test.mjs",
    "test:mail:connect:browser": "node tools/admin-mail-connect-browser.mjs && node tools/mail-connect-public-browser.mjs",
    "test:admin:login": "PHASE1=1 node build.mjs && node tools/admin-login-browser.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "7.2.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@vercel/functions": "^3.11.0",
    "fflate": "0.8.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@fontsource/damion": "^5.3.0",
    "@playwright/test": "1.56.1",
    "axe-core": "^4.14.0",
    "lighthouse": "13.6.0"
  }
}
